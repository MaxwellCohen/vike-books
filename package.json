{
  "name": "vike-books",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vike/bin.js dev --port 3000",
    "build": "vike build",
    "preview": "vike build && vike preview",
    "typecheck": "tsc --noEmit",
    "deploy:vercel": "vercel build --prod --yes && vercel deploy --prebuilt --prod --yes",
    "deploy:netlify": "NETLIFY=1 pnpm build && npx --yes netlify-cli deploy --prod --no-build",
    "deploy:cloudflare": "CLOUDFLARE=1 pnpm build && wrangler deploy",
    "preview:cloudflare": "CLOUDFLARE=1 pnpm build && wrangler dev"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.44",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "@netlify/blobs": "^11.1.12",
    "@vercel/functions": "^3.11.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.81.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.1",
    "thumbhash": "^0.1.1",
    "unlazy": "^2.0.1",
    "vike": "^0.4.270",
    "vike-react": "^0.6.32"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@netlify/vite-plugin": "^3.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-vercel": "^11.2.0",
    "wrangler": "^4.168.0"
  }
}
